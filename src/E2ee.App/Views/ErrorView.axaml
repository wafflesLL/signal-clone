<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:E2ee.App.ViewModels"
             x:Class="E2ee.App.Views.ErrorView"
             x:DataType="vm:ErrorViewModel">
  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Spacing="10">
    <TextBlock Classes="title" Text="Can't open your profile" />
    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
