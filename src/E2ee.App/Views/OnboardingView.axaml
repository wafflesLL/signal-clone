<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:E2ee.App.ViewModels"
             x:Class="E2ee.App.Views.OnboardingView"
             x:DataType="vm:OnboardingViewModel">
  <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="380" Padding="32"
          CornerRadius="12" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
    <StackPanel Spacing="14">
      <TextBlock Classes="title" Text="E2EE Messenger" />
      <TextBlock Classes="muted" TextWrapping="Wrap"
                 Text="Messages are end-to-end encrypted. The relay only ever sees ciphertext. Your keys are created on this computer and never leave it." />

      <StackPanel Spacing="4">
        <TextBlock Text="Username" />
        <TextBox Name="UsernameBox" Text="{Binding Username}" Watermark="e.g. alice" MaxLength="32" />
      </StackPanel>

      <StackPanel Spacing="4">
        <TextBlock Text="Password" />
        <TextBox Name="PasswordBox" Text="{Binding Password}" PasswordChar="•" Watermark="At least 8 characters" />
        <TextBox Name="ConfirmPasswordBox" Text="{Binding ConfirmPassword}" PasswordChar="•" Watermark="Type it again" />
        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                   Text="Locks the app on this computer. It never leaves this device and can't be recovered, so keep it somewhere safe." />
      </StackPanel>

      <StackPanel Spacing="4">
        <TextBlock Text="Relay address" />
        <TextBox Name="ServerBox" Text="{Binding ServerUrl}" Watermark="https://relay.example.org" />
      </StackPanel>

      <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

      <Button Content="Create account" Command="{Binding RegisterCommand}" IsDefault="True"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Classes="accent" />
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
      <Button Name="OtherAccountButton" Content="Use an account already on this computer" Command="{Binding UseOtherAccountCommand}"
              Classes="link" HorizontalAlignment="Center" IsVisible="{Binding CanUseOtherAccount}" />
    </StackPanel>
  </Border>
</UserControl>
