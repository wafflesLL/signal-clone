<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>E2eeMessenger</AssemblyName>
    <RootNamespace>E2ee.App</RootNamespace>
    <!-- The relay new accounts sign up on. Override at build time: -p:DefaultRelay=https://... -->
    <ApplicationIcon>..\..\assets\icon.ico</ApplicationIcon>
    <DefaultRelay Condition="'$(DefaultRelay)' == ''">https://signal-clone.duckdns.org:8443</DefaultRelay>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>DefaultRelay</_Parameter1>
      <_Parameter2>$(DefaultRelay)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\..\assets\icon.ico" Link="Assets\icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="E2ee.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\E2ee.Messaging\E2ee.Messaging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.23" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.23" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.23" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.23" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>

</Project>
